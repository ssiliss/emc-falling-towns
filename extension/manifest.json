{
  "manifest_version": 3,
  "name": "EMC Falling Towns",
  "version": "0.6.0",
  "description": "Highlights the towns that fall at the next daily run on the legacy EarthMC map, with their nearest teleports. No setup needed.",
  "host_permissions": [
    "https://gist.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://legacymap.earthmc.net/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://legacymap.earthmc.net/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
